# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here

# API
NEXT_PUBLIC_API_URL=http://localhost:8000

# PostgreSQL / PostGIS
POSTGRES_USER=geoai
POSTGRES_PASSWORD=geoai_secret
POSTGRES_DB=geoai_explorer
DATABASE_URL=postgresql+asyncpg://geoai:geoai_secret@db:5432/geoai_explorer
DATABASE_URL_SYNC=postgresql://geoai:geoai_secret@db:5432/geoai_explorer

# Planetary Computer (optional; unsigned STAC works for many assets)
PC_SUBSCRIPTION_KEY=
